{
  "name": "pixelflow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "oxlint --deny-warnings src tests scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "model:prepare": "node scripts/prepare-ben2.ts",
    "bench:ben2": "node scripts/benchmark-ben2.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test && pnpm run start"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "chokidar": "6.0.0",
    "p-queue": "10.0.0",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "valibot": "1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.95.0",
    "@types/node": "24.19.4",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "packageManager": "pnpm@10.34.9"
}
